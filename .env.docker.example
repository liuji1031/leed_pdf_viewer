# Copy to .env next to docker-compose.yml. Every value is optional.

# --- Document parser (MinerU) -------------------------------------------
# Default: the bundled `mineru` service. To use mineru.net instead:
#   MINERU_URL=https://mineru.net/api
#   MINERU_API_KEY=sk_...
# A hosted parser receives a copy of every paper that's opened.
MINERU_URL=
MINERU_API_KEY=

# GPU override only (docker-compose.gpu.yml). Tier the bundled server runs:
# standard (VLM, default) or basic (small models only).
MINERU_TIER=
# Set to 8 on a 6 GB card, or vLLM won't start. Leave empty on 8 GB and up.
MINERU_VIRTUAL_VRAM_SIZE=

# --- Chat (OpenRouter) ----------------------------------------------------
# Used server-side by the /api/openrouter relay; never sent to the browser.
OPENROUTER_API_KEY=
# Any OpenRouter model id, e.g. anthropic/claude-sonnet-5
OPENROUTER_MODEL=
# Model for highlight hover summaries; empty uses OPENROUTER_MODEL.
# A cheap non-reasoning model works best, e.g. anthropic/claude-haiku-4.5
OPENROUTER_SUMMARY_MODEL=

# --- Production app -------------------------------------------------------
# Public URL the app is served at (adapter-node checks it for form posts).
ORIGIN=http://localhost:3000
APP_PORT=3000

# --- Build-time public config (inlined into the client at build time) -----
PUBLIC_POSTHOG_KEY=
PUBLIC_APPWRITE_ENDPOINT=
PUBLIC_APPWRITE_PROJECT_ID=
PUBLIC_APPWRITE_DATABASE_ID=
PUBLIC_APPWRITE_STORAGE_BUCKET_ID=
PUBLIC_APPWRITE_SHARED_PDFS_COLLECTION_ID=
PUBLIC_APPWRITE_PDF_ANNOTATIONS_COLLECTION_ID=

# --- Server-side --------------------------------------------------------------
BRAVE_SEARCH_API_KEY=
